# Official tiny fixtures and snapshots are required by upstream tests.
!assignments/**/tests/fixtures/**/*.pt
!assignments/**/tests/fixtures/**/*.bin
!assignments/**/tests/fixtures/**/*.safetensors
!assignments/**/tests/_snapshots/**/*.npy
!assignments/**/tests/_snapshots/**/*.npz

